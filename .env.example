# ---------------------------------------------------------------------------
# Copy to .env and edit.  .env is gitignored - never commit real values.
# ---------------------------------------------------------------------------

# REQUIRED. The bearer token your iPhone Shortcut sends. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_ASSISTANT_TOKEN=

# --- server ---------------------------------------------------------------
# 0.0.0.0 so the iPhone on your Wi-Fi can reach it. 127.0.0.1 = Mac only.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- local LLM ------------------------------------------------------------
LLM_PROVIDER=ollama            # ollama | echo  (mlx reserved for later)
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b             # qwen3:14b for better quality, ~2x slower
LLM_TEMPERATURE=0.4
LLM_ENABLE_THINKING=false      # true costs many seconds per spoken answer
LLM_KEEP_ALIVE=10m             # how long Ollama holds the weights in RAM
LLM_NUM_CTX=8192
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS_SIRI=400
LLM_MAX_TOKENS_DEFAULT=900

# --- search ---------------------------------------------------------------
SEARCH_PROVIDER=duckduckgo     # duckduckgo | brave | tavily | searxng
SEARCH_RESULTS=8
SEARCH_TIMEOUT_S=10
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8080

# --- retrieval ------------------------------------------------------------
FETCH_MAX_PAGES=4
FETCH_TIMEOUT_S=8
FETCH_MAX_BYTES=2000000
FETCH_CONCURRENCY=4

# --- RAG ------------------------------------------------------------------
CHUNK_CHARS=1200
RAG_TOP_CHUNKS=6
RAG_CONTEXT_BUDGET_CHARS=6000
