# British Conversation Coach configuration. Copy to .env and edit.
# Every setting has a sensible default; see britcoach/config.py for the full list.

# ---- LLM ---------------------------------------------------------------
# mlx (Apple Silicon) | ollama | openai_compat (llama.cpp llama-server, LM Studio) | mock
COACH_LLM_BACKEND=mlx
# small (1.5B) | medium (3B/4B, recommended) | large (7B/8B)  - see config/models.toml
COACH_LLM_PROFILE=medium
# Override the profile's model id, e.g. mlx-community/Qwen3-4B-4bit
COACH_LLM_MODEL=
COACH_LLM_MAX_TOKENS=110
# COACH_OLLAMA_URL=http://127.0.0.1:11434
# COACH_OPENAI_COMPAT_URL=http://127.0.0.1:8080/v1

# ---- Speech-to-text --------------------------------------------------------
# faster_whisper (CPU int8, leaves the GPU to the LLM) | whispercpp | mock
COACH_STT_BACKEND=faster_whisper
# tiny.en (fastest) | base.en (default) | small.en (most accurate, slower)
COACH_STT_MODEL=base.en
COACH_STT_THREADS=4

# ---- Text-to-speech ----------------------------------------------------------
# piper | macos_say (built-in voices such as "Daniel", no download) | mock
COACH_TTS_BACKEND=piper
COACH_TTS_VOICE=en_GB-cori-medium

# ---- Turn-taking -----------------------------------------------------------------
# Silence (ms) that ends your turn. Lower = snappier but more likely to cut you off.
COACH_END_OF_TURN_MS=560
# headphones | speakers | off
COACH_BARGE_IN_MODE=headphones

# ---- Optional cloud analysis (OFF by default) ---------------------------------------
# Conversation never leaves the machine. When enabled, text is only sent for an
# explicitly requested advanced review (with consent) or opted-in turn corrections.
COACH_CLOUD_ENABLED=false
# anthropic | openai
COACH_CLOUD_PROVIDER=anthropic
# explicit_only | local_failure (offer cloud when the local review analysis fails; consent still required)
COACH_CLOUD_ESCALATION=explicit_only
# COACH_ANTHROPIC_MODEL=claude-opus-5-5
# COACH_OPENAI_MODEL=gpt-5-mini
# Keys are read from these standard variables. Put them here or export them in your shell.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Storage ----------------------------------------------------------------------------
COACH_SAVE_HISTORY=true
